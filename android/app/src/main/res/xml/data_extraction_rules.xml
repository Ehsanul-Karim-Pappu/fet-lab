<?xml version="1.0" encoding="utf-8"?>
<!-- Tour completion and sheet see-through are local; exclude preferences from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
